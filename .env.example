# Runtime mode and deployment scope
# Operational RCA_* values below are optional emergency overrides; normally use the database parameter API.
# Set demo explicitly only for simulations; live mode fails closed without identity configuration.
RCA_MODE=live
RCA_TENANT_ID=acme
RCA_PROJECT_ID=payments-prod
RCA_AUTH_ISSUER=
RCA_AUTH_AUDIENCE=
RCA_AUTH_PUBLIC_KEY=
RCA_PRINCIPALS_JSON={}
# RCA_MAX_CONCURRENT_RUNS=4
# RCA_RUN_TIMEOUT_SECONDS=120
# RCA_MAX_LLM_CALLS=12
# RCA_MAX_CONCURRENT_UPLOADS=2
# RCA_MAX_JSON_BODY_BYTES=131072
# RCA_MAX_PARALLEL_MODELS=4
# RCA_MAX_INPUT_CHARS=16000
# RCA_MAX_CONTEXT_CHARS=64000
# RCA_MAX_EVIDENCE_ITEMS=100
# RCA_MAX_EVIDENCE_CHARS=12000
# Includes layers/platform.yaml plus administrator-managed layers/projects and layers/users.
RCA_CONTENT_ROOT=./blob_local/platform
RCA_CONFIG_DIR=./blob_local/platform/config
# Project configuration is local/mounted; artifacts may use a GCS projects prefix.
RCA_PROJECTS_ROOT=./blob_local/projects
# RCA_PROJECTS_BLOB_URI=gs://YOUR_BUCKET/rca/projects
# Legacy explicit artifact locations, if already used, remain supported:
# RCA_CONFIG_BLOB_URI=./blob_local/agent-configurations
# RCA_MAX_AGENT_YAML_BYTES=65536
# RCA_OPTIMIZATION_BLOB_URI=./blob_local/optimizations
# Local db-deploy sets PostgreSQL-backed MLflow metadata automatically.
# RCA_OPTIMIZATION_TRACKING_URI=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/rca_db?options=-csearch_path%3Dmlflow

# Storage: SQLite is for isolated demos/tests. make db-deploy generates local PostgreSQL URLs.
RCA_DATABASE_CONFIGURATION=false
RCA_DATABASE_URL=sqlite+aiosqlite:///./data/rca.db
RCA_SESSION_DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db
# RCA_ATTACHMENT_TTL_SECONDS=86400
# RCA_MAX_UPLOAD_BATCH_BYTES=33554432
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=
POSTGRES_DB=rca_db
POSTGRES_PORT=5432

# Google ADK / model configuration
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# External connectors
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_PROJECT_KEY=
SPLUNK_HOST=
SPLUNK_TOKEN=
SPLUNK_INDEX=

# Explicit destinations for manual MCP/A2A connection tests. Registration itself
# performs no network request. Credential references are approved per host.
RCA_INTEGRATION_ALLOWED_HOSTS=
RCA_INTEGRATION_SECRET_REFERENCES='{}'
# Example: {"mcp.example.com":["env://MCP_API_TOKEN"]}

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rca-analyzer
MLFLOW_EXPERIMENT_ID=

# Optional native evidence connectors. Enable each in the active connectors.yaml.
# Exact endpoint formats and permissions: docs/connectors.md
CONFLUENCE_ENDPOINT=
CONFLUENCE_TOKEN=
CONFLUENCE_SCOPE=
SIGNALFX_ENDPOINT=
SIGNALFX_TOKEN=
SIGNALFX_SCOPE=
QTEST_ENDPOINT=
QTEST_TOKEN=
QTEST_SCOPE=
GITLAB_ENDPOINT=
GITLAB_TOKEN=
GITLAB_SCOPE=
KUBERNETES_ENDPOINT=
KUBERNETES_TOKEN=
KUBERNETES_SCOPE=
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_SCOPE=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SCOPE=
KAFKA_CA_FILE=
UNIX_HOST=
UNIX_PORT=22
UNIX_USER=
UNIX_CLIENT_KEY=
UNIX_KNOWN_HOSTS=
UNIX_LOG_PATH=
# MCP uses <CONNECTOR_ID>_ENDPOINT, _TOKEN and _SCOPE instead of native settings.
# Jira MCP uses ITSM_*; Splunk MCP uses LOG_SEARCH_*.
# Optional private TLS roots: <CONNECTOR_ID>_CA_FILE.

# Exact approved MCP stdio process profiles: [{"command":..., "args":[...], "env":{...}}].
# No command process is permitted by default. env values must be env:// references.
RCA_MCP_STDIO_ALLOWLIST=[]
